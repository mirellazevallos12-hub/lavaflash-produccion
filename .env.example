# Copia este archivo como .env SOLO para desarrollo local.
# En la nube configura estas variables desde el panel del proveedor.
LAVAFLASH_ADMIN_USER=admin
LAVAFLASH_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA_DE_12_O_MAS
LAVAFLASH_SESSION_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_64_CARACTERES_O_MAS
LAVAFLASH_ADMIN_NAME=Administrador LavaFlash
LAVAFLASH_ADMIN_BRANCH=LavaFlash
PORT=8080
# En nube monta un disco persistente y apunta esta variable al volumen.
LAVAFLASH_DATABASE_FILE=./data/lavaflash.sqlite
